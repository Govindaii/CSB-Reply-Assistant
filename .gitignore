# ── Secrets: never commit these ─────────────────────────────
# The extension keeps your API key ONLY in chrome.storage.local
# (inside Chrome). Nothing in this repo should ever hold a key.
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
*.crx
secrets*
*secret*
*apikey*
*api-key*
*api_key*
credentials*
keys.json
config.local.*
*.local.json

# ── OS / editor clutter ─────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# ── Build / tooling (there is no build step, but just in case) ─
node_modules/
dist/
*.zip
*.log
test-results/
playwright-report/
